{
  "version": 3,
  "summary": "x.md exposes a public read-only HTTP API with an OpenAPI 3.1 description and a public MCP server over Streamable HTTP, both for reading public X posts, threads, profiles, and search results as Markdown or JSON; no credentials required.",
  "surfaces": [
    {
      "slug": "x-md-api",
      "name": "x.md API",
      "type": "http",
      "url": "https://x.pcstyle.dev/api/v1",
      "spec": "https://x.pcstyle.dev/openapi.json",
      "docs": "https://x.pcstyle.dev/docs",
      "basis": {
        "via": "declared",
        "source": "https://x.pcstyle.dev/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://x.pcstyle.dev/.well-known/integrations.json"
        }
      }
    },
    {
      "slug": "x-md-mcp",
      "name": "x.md MCP server",
      "type": "mcp",
      "url": "https://x.pcstyle.dev/mcp",
      "transports": ["streamable-http"],
      "docs": "https://x.pcstyle.dev/docs/mcp",
      "basis": {
        "via": "declared",
        "source": "https://x.pcstyle.dev/.well-known/integrations.json"
      },
      "auth": {
        "status": "none",
        "basis": {
          "via": "declared",
          "source": "https://x.pcstyle.dev/.well-known/integrations.json"
        }
      }
    }
  ]
}
