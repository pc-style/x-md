        "mcp",
        "x",
        "twitter",
        "markdown",
        "read-only"
      ],
      "capabilities": [
        "x_md_get_post",
        "x_md_get_profile",
        "x_md_search_posts",
        "x_md_get_followers",
        "x_md_get_following"
      ],
