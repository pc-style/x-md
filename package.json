{
  "name": "x-md",
  "version": "1.1.0",
  "description": "Agent-friendly, read-only X browser with compact Markdown and JSON output",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pc-style/x-md.git"
  },
  "bugs": {
    "url": "https://github.com/pc-style/x-md/issues"
  },
  "homepage": "https://x.pcstyle.dev",
  "keywords": [
    "x",
    "twitter",
    "markdown",
    "agents",
    "search",
    "profiles",
    "converter",
    "obsidian",
    "vercel",
    "open-source"
  ],
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc && bun run docs:build && bun run openapi:build && bun --bun vite build && bun run skills:publish",
    "preview": "vite preview",
    "browse-x": "bun skills/browse-x/scripts/browse-x.ts",
    "test": "bun --bun vitest --run",
    "docs:dev": "bun --bun blume dev",
    "docs:build": "bun --bun blume build",
    "openapi:build": "bun scripts/build-openapi.ts",
    "openapi:check": "bun scripts/build-openapi.ts --check",
    "skills:publish": "bun scripts/patch-agent-skills.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vercel/build-utils": "14.9.0",
    "@vercel/node": "12.0.0",
    "blume": "^1.6.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "gsap": "^3.15.0",
    "posthog-js": "^1.427.2",
    "tailwindcss": "^4.3.3"
  },
  "patchedDependencies": {
    "@the-convocation/twitter-scraper@0.22.3": "patches/@the-convocation%2Ftwitter-scraper@0.22.3.patch"
  }
}
