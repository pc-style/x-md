{
  "name": "x-md",
  "version": "1.0.0",
  "description": "Agent-friendly, read-only X browser with compact Markdown and JSON output",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pc-style/x-md.git"
  },
  "bugs": {
    "url": "https://github.com/pc-style/x-md/issues"
  },
  "homepage": "https://x.pcstyle.dev",
  "keywords": [
    "x",
    "twitter",
    "markdown",
    "agents",
    "search",
    "profiles",
    "converter",
    "obsidian",
    "vercel",
    "open-source"
  ],
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun tsc && bun run docs:build && bun --bun vite build",
    "preview": "vite preview",
    "browse-x": "bash skills/browse-x/scripts/browse-x.sh",
    "test": "bun --bun vitest --run",
    "docs:dev": "bun --bun blume dev",
    "docs:build": "bun --bun blume build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vercel/node": "^5.8.4",
    "blume": "^1.6.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.0"
  }
}
