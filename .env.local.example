# Optional scrape fallbacks when FxTwitter/syndication fail (local/self-host only)
# Do not set on Vercel Production for the public x-md deploy unless you want paid fallbacks enabled there
CONTEXT_DEV_API_KEY=
FIRECRAWL_API_KEY=

# Converter cache (optional)
CACHE_TTL_SECONDS=3600
# CACHE_DISABLED=1
# CACHE_PERSIST=0

# Admin dashboard for API keys (/admin). Bearer token guarding /api/admin/*.
# Unset = admin locked. Generate one, e.g.: openssl rand -hex 32
X_MD_ADMIN_TOKEN=

# API keys and their per-15-min allowances persist in the shared KV store below.
# Without it, keys live only in the warm instance's memory (fine for local dev,
# lost on redeploy). Reuses the rate limiter's store if already set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional PostHog analytics and error tracking. Browser and server use the same project token.
# .env.local overrides .env; check both after running the PostHog wizard.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# Build-only source-map upload credentials. Never use a VITE_ prefix for the personal key.
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
