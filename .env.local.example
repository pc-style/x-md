# Optional scrape fallbacks when FxTwitter/syndication fail (local/self-host only)
# Do not set on Vercel Production for the public x-md deploy unless you want paid fallbacks enabled there
CONTEXT_DEV_API_KEY=
FIRECRAWL_API_KEY=

# Converter cache (optional)
CACHE_TTL_SECONDS=3600
# CACHE_DISABLED=1
# CACHE_PERSIST=0

# Admin dashboard for API keys (/admin). Bearer token guarding /api/admin/*.
# Unset = admin locked. Generate one, e.g.: openssl rand -hex 32
X_MD_ADMIN_TOKEN=

# API keys and their per-15-min allowances persist in the shared KV store below.
# Without it, keys live only in the warm instance's memory (fine for local dev,
# lost on redeploy). Reuses the rate limiter's store if already set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
